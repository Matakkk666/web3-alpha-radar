# Telegram (оба имени работают)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklmno
TELEGRAM_ADMIN_ID=123456789

# Google Gemini
GEMINI_API_KEY=AIzaSy...

# Proxy for Playwright / HTTP (optional)
PROXY_URL=http://user:pass@ip:port

# X session cookie auth_token and list URL
X_AUTH_TOKEN=длинная_строка_из_cookies
X_LIST_URL=https://x.com/i/lists/123456789

# Logging / scheduler
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow
